generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  ES @map("es")
  EN @map("en")
}

enum SkillPresentation {
  ICON_TILES @map("icon_tiles")
  BADGES     @map("badges")
}

enum ProjectStatus {
  PLANNED     @map("planned")
  IN_PROGRESS @map("in_progress")
  PAUSED      @map("paused")
  COMPLETED   @map("completed")
  ARCHIVED    @map("archived")
}

enum DocumentKind {
  PUBLIC_CV    @map("public_cv")
  ATS_CV       @map("ats_cv")
  COVER_LETTER @map("cover_letter")
}

enum DocumentStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")
}

model Profile {
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique
  fullName     String
  email        String?
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  socialLinks  SocialLink[]
  translations ProfileTranslation[]
}

model SocialLink {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId       String   @db.Uuid
  slug            String
  label           String
  detail          String?
  url             String
  iconKey         String?
  showOnPortfolio Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, slug])
  @@index([profileId, showOnPortfolio, order])
}

model ProfileTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  profileId   String  @db.Uuid
  locale      Locale
  title       String
  longBio     String  @db.Text
  contactText String  @db.Text
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, locale])
  @@index([locale])
}

model Experience {
  id              String                  @id @default(uuid()) @db.Uuid
  slug            String                  @unique
  company         String
  startDate       DateTime                @db.Date
  endDate         DateTime?               @db.Date
  showOnPortfolio Boolean                 @default(true)
  showOnCv        Boolean                 @default(true)
  order           Int                     @default(0)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  translations    ExperienceTranslation[]

  @@index([showOnPortfolio, order])
  @@index([showOnCv, order])
}

model ExperienceTranslation {
  id           String     @id @default(uuid()) @db.Uuid
  experienceId String     @db.Uuid
  locale       Locale
  role         String
  description  String     @db.Text
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, locale])
  @@index([locale])
}

model Education {
  id              String                 @id @default(uuid()) @db.Uuid
  slug            String                 @unique
  institution     String
  startDate       DateTime               @db.Date
  endDate         DateTime?              @db.Date
  showOnPortfolio Boolean                @default(true)
  showOnCv        Boolean                @default(true)
  order           Int                    @default(0)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  translations    EducationTranslation[]

  @@index([showOnPortfolio, order])
  @@index([showOnCv, order])
}

model EducationTranslation {
  id          String    @id @default(uuid()) @db.Uuid
  educationId String    @db.Uuid
  locale      Locale
  degree      String
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@unique([educationId, locale])
  @@index([locale])
}

model Project {
  id                 String               @id @default(uuid()) @db.Uuid
  slug               String               @unique
  repositoryFullName String?              @unique
  demoUrl            String?
  repositoryUrl      String?
  techStack          String[]             @default([])
  showOnPortfolio    Boolean              @default(true)
  showOnCv           Boolean              @default(false)
  order              Int                  @default(0)
  status             ProjectStatus        @default(PLANNED)
  progressPct        Int                  @default(0)
  lastTelemetryAt    DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  translations       ProjectTranslation[]
  integration        ProjectIntegration?
  syncJobs           ProjectSyncJob[]
  knowledge          ProjectKnowledge[]

  @@index([showOnPortfolio, order])
  @@index([showOnCv, order])
  @@index([status])
}

model ProjectTranslation {
  id           String  @id @default(uuid()) @db.Uuid
  projectId    String  @db.Uuid
  locale       Locale
  name         String
  summary      String  @db.Text
  detailedInfo String  @db.Text
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectIntegration {
  projectId     String   @id @db.Uuid
  repositoryId  String   @unique
  branch        String   @default("main")
  sourcePaths   String[]
  enabled       Boolean  @default(false)
  assets        Json     @default("[]") @db.JsonB
  milestones    Json     @default("[]") @db.JsonB
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectSyncJob {
  id                     String    @id @default(uuid()) @db.Uuid
  projectId              String    @db.Uuid
  deliveryId             String    @unique
  requestedSha           String?
  configurationUpdatedAt DateTime  @db.Timestamptz(3)
  status                 String    @default("QUEUED")
  attempts               Int       @default(0)
  availableAt            DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken             String?   @db.Uuid
  leaseUntil             DateTime? @db.Timestamptz(3)
  error                  String?
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt             DateTime? @db.Timestamptz(3)
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([projectId, createdAt(sort: Desc)])
}

model ProjectKnowledge {
  id                     String    @id @default(uuid()) @db.Uuid
  projectId              String    @db.Uuid
  status                 String    @default("DRAFT")
  commitSha              String
  repositoryFullName     String
  configurationUpdatedAt DateTime  @db.Timestamptz(3)
  projectUpdatedAt       DateTime  @db.Timestamptz(3)
  narrative              Json      @db.JsonB
  generationModel        String
  embeddingModel         String
  createdAt              DateTime  @default(now()) @db.Timestamptz(3)
  publishedAt            DateTime? @db.Timestamptz(3)
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks                 ProjectKnowledgeChunk[]

  @@index([projectId, status])
}

model ProjectKnowledgeChunk {
  id          String                    @id @default(uuid()) @db.Uuid
  knowledgeId String                    @db.Uuid
  path        String
  ordinal     Int
  content     String                    @db.Text
  sourceHash  String
  sourceUrl   String
  embedding   Unsupported("vector(768)")
  knowledge   ProjectKnowledge          @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@unique([knowledgeId, path, ordinal])
}

model ProjectQueryQuota {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model SkillCategory {
  id              String                     @id @default(uuid()) @db.Uuid
  slug            String                     @unique
  presentation    SkillPresentation
  showOnPortfolio Boolean                    @default(true)
  showOnCv        Boolean                    @default(true)
  order           Int                        @default(0)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(3)
  skills          Skill[]
  translations    SkillCategoryTranslation[]

  @@index([showOnPortfolio, order])
  @@index([showOnCv, order])
}

model SkillCategoryTranslation {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @db.Uuid
  locale      Locale
  title       String
  description String        @db.Text
  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model Skill {
  id              String             @id @default(uuid()) @db.Uuid
  slug            String             @unique
  iconKey         String?
  showOnPortfolio Boolean            @default(true)
  showOnCv        Boolean            @default(true)
  order           Int                @default(0)
  categoryId      String             @db.Uuid
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  category        SkillCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations    SkillTranslation[]

  @@index([categoryId, order])
  @@index([showOnPortfolio, order])
  @@index([showOnCv, order])
}

model SkillTranslation {
  id      String @id @default(uuid()) @db.Uuid
  skillId String @db.Uuid
  locale  Locale
  name    String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, locale])
  @@index([locale])
}

model AiContext {
  id                  String   @id @default(uuid()) @db.Uuid
  professionalContext String   @db.Text
  personalContext     String   @db.Text
  createdAt           DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)], map: "AiContextVersion_createdAt_idx")
  @@map("AiContextVersion")
}

model JobApplication {
  id             String             @id @default(uuid()) @db.Uuid
  locale         Locale
  company        String
  role           String
  sourceUrl      String?
  jobDescription String             @db.Text
  notes          String?            @db.Text
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  artifacts      DocumentArtifact[]

  @@index([createdAt(sort: Desc)])
  @@index([company, role])
}

model DocumentArtifact {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String?           @db.Uuid
  kind          DocumentKind
  locale        Locale
  status        DocumentStatus    @default(DRAFT)
  title         String
  content       Json              @db.JsonB
  sourceHash    String
  model         String
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?         @db.Timestamptz(3)
  application   JobApplication?   @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt(sort: Desc)])
  @@index([kind, locale, status, createdAt(sort: Desc)])
}
